{
  "name": "yt-overlay",
  "version": "2026.6.4",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.overlay.app",
    "productName": "YouTubeOverlay",
    "artifactName": "${productName}-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "express": "^5.2.1",
    "obs-websocket-js": "^5.0.8",
    "playwright": "^1.57.0"
  }
}
