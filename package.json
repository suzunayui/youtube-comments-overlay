{
  "name": "yt-overlay",
  "version": "2026.10.10-17",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64",
    "postinstall": "electron-builder install-app-deps",
    "test": "node --test tests/*.test.js",
    "build:translation": "node scripts/build-translation.cjs",
    "build:subtitles": "node scripts/build-subtitles.cjs"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.overlay.app",
    "productName": "YouTubeOverlay",
    "artifactName": "${productName}-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "translation/icon.ico",
      "signExecutable": false
    },
    "files": [
      "*.js",
      "*.html",
      "translation/**",
      "subtitles/**",
      "runtime/**",
      "package.json",
      "!**/__pycache__/**",
      "!**/*.pyc",
      "LICENSE",
      "README.md"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ja_JP",
        "en_US"
      ]
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "obs-websocket-js": "^5.0.8",
    "playwright": "^1.57.0"
  }
}
